# =============================================================================
# Variables de entorno — logistics-routes
# Copia este archivo como ".env" y rellena los valores reales.
# El archivo .env NUNCA se sube a git (está en .gitignore).
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Usadas por el contenedor postgres Y por la app (via docker-compose)
POSTGRES_DB=logistics_routes_dev
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=logistics_dev_pwd

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera tu propio secret: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secret-seguro-minimo-32-chars
JWT_EXPIRATION_MS=86400000

# ── AWS ───────────────────────────────────────────────────────────────────────
# Región de tu cuenta AWS. Las credenciales las provee el IAM Role del EC2.
AWS_REGION=us-east-2

# ── SQS — nombres exactos de las colas creadas en la consola AWS ─────────────
SQS_SOLICITUDES_RUTA_QUEUE=logistics-solicitudes-ruta
SQS_EVENTOS_PAQUETE_QUEUE=logistics-eventos-paquete
SQS_CIERRE_RUTA_QUEUE=logistics-cierre-ruta
SQS_RESPUESTAS_RUTA_QUEUE=respuestas-ruta-queue

# ── S3 — nombre exacto del bucket ────────────────────────────────────────────
S3_BUCKET_POD=logistics-pod-fotos
